# 应用访问
APP_PASSWORD=changeme

# 敏感配置加密密钥（AES-GCM，base64 32 字节）
# 生成：openssl rand -base64 32
# 重要：该密钥丢失后，库中加密字段（平台 Cookie、OpenList token）将无法解密，请与数据库一起备份
APP_ENCRYPTION_KEY=

# 数据库
DATABASE_PATH=./data/myporn.db
DATA_DIR=./data

# 本地库默认根目录（可在 UI 里再创建多个库）
LIBRARY_ROOT=./media

# OpenList
OPENLIST_BASE_URL=http://192.168.0.108:5244
OPENLIST_TOKEN=
OPENLIST_ROOT=/123云盘/资源目录/MyPorn

# 网络出口
# 全局代理，例：socks5://127.0.0.1:7890 或 http://127.0.0.1:8080，留空=直连
GLOBAL_PROXY=
# 按平台覆盖，例：PLATFORM_PROXY_PORNHUB=socks5://127.0.0.1:7890
PLATFORM_PROXY_PORNHUB=
PLATFORM_PROXY_XHAMSTER=
PLATFORM_PROXY_BEEG=
PLATFORM_PROXY_X=

# 任务并发
MAX_DOWNLOAD_JOBS=2
MAX_UPLOAD_JOBS=2
MAX_FETCH_JOBS=4
DOWNLOAD_CONNECTIONS_PER_FILE=8

# 同步
SYNC_INTERVAL_HOURS=6
